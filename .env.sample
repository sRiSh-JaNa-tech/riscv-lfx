# Podman Flaky Test Analyzer Environment Configuration
# Copy this file to .env and fill in your API keys:
#   cp .env.sample .env

# GitHub Personal Access Token (requires repo / issues permissions)
GITHUB_TOKEN=ghp_your_github_token_here

# OpenAI API Key (or key for your chosen LLM provider)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: LLM Model Selection (default: gpt-4o)
# Examples: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20240620, gemini/gemini-1.5-pro, ollama/llama3
LITELLM_MODEL=gpt-4o

# Optional: Target GitHub repository (default: containers/podman)
PODMAN_REPO=containers/podman
